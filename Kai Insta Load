local function try(fn, ...) local ok = pcall(fn, ...) return ok end

try(function() if setfpscap then setfpscap(9999) end end)

local hookfn = hookfunction or replaceclosure or (syn and syn.hookfunction)
local newcclosure = newcclosure or function(f) return f end

local ContentProvider = game:GetService("ContentProvider")
try(function()
    if hookfn then
        local realPreload = ContentProvider.PreloadAsync
        hookfn(realPreload, newcclosure(function(self, list, cb)
            if type(cb) == "function" and type(list) == "table" then
                for i = 1, #list do try(cb, list[i], Enum.AssetFetchStatus.Success) end
            end
            return
        end))
    end
end)

