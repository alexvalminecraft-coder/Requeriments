local killers = {}
local function stripEffects(inst)
    if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
        or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
        try(function() inst.Enabled = false end)
    end
end

try(function()
    for _, d in ipairs(workspace:GetDescendants()) do stripEffects(d) end
    killers[#killers + 1] = workspace.DescendantAdded:Connect(stripEffects)
end)

local function nukeLoadingGuis()
    local names = { "loading", "loadingscreen", "loadscreen", "splash",
        "intro", "cutscene", "playbutton", "startscreen", "mainmenu" }
    local function looksLikeLoader(gui)
        local n = tostring(gui.Name):lower()
        for _, k in ipairs(names) do if n:find(k) then return true end end
        return false
    end
    local function scan(container)
        if not container then return end
        for _, g in ipairs(container:GetChildren()) do
            if (g:IsA("ScreenGui") or g:IsA("GuiMain") or g:IsA("Frame")) and looksLikeLoader(g) then
                try(function() g.Enabled = false end)
                try(function() g.Visible = false end)
            end
        end
    end
    scan(ReplicatedFirst)
    local lp = game:GetService("Players").LocalPlayer
    if lp then scan(lp:FindFirstChildOfClass("PlayerGui")) end
    if typeof(gethui) == "function" then try(function() scan(gethui()) end) end
    try(function() scan(game:GetService("CoreGui")) end)
end

try(function()
    for _, ls in ipairs(ReplicatedFirst:GetChildren()) do
        if ls:IsA("LocalScript") or ls:IsA("Script") then
            local n = ls.Name:lower()
            if n:find("load") or n:find("intro") or n:find("splash") then
                try(function() ls.Disabled = true end)
            end
        end
    end
end)

if not game:IsLoaded() then
    try(function()
        local t = tick()
        while not game:IsLoaded() and tick() - t < 30 do
            game.Loaded:Wait()
        end
    end)
end

try(function()
    local Players = game:GetService("Players")
    if not Players.LocalPlayer then
        Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
    end
    local lp = Players.LocalPlayer
    if lp and not lp:FindFirstChildOfClass("PlayerGui") then
        lp:WaitForChild("PlayerGui", 15)
    end
    if lp and not lp.Character then
        lp.CharacterAdded:Wait()
    end
    local char = lp and lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and workspace.StreamingEnabled then
        try(function() lp:RequestStreamAroundAsync(hrp.Position, 5) end)
    end
end)

for i = 1, 3 do
    try(nukeLoadingGuis)
    task.wait(0.15)
end

task.delay(6, function()
    for _, c in ipairs(killers) do try(function() c:Disconnect() end) end
end)
